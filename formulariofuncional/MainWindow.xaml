<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="formulariofuncional.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:formulariofuncional"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#F1F5F9" RequestedTheme="Light">
        <Grid.Resources>
            <!-- Color del boton principal -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F766E"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115E59"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#134E4A"/>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Border Grid.Row="0" Background="#0F766E" Padding="30,20">
            <StackPanel Spacing="2">
                <TextBlock Text="Inventario de productos" FontSize="28" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Registra, consulta y controla la disponibilidad de tus productos"
                           Foreground="#CCFBF1"/>
            </StackPanel>
        </Border>

        <!-- Contenido -->
        <Grid Grid.Row="1" Padding="30" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- IZQUIERDA: formulario -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="24"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <ScrollViewer>
                    <StackPanel Spacing="14">
                        <TextBlock Text="Nuevo producto" FontSize="20" FontWeight="SemiBold" Foreground="#0F766E"/>

                        <TextBox x:Name="txtProducto" Header="Nombre del producto" PlaceholderText="Ej. Cuaderno"/>
                        <TextBox x:Name="txtPrecio" Header="Precio" PlaceholderText="Ej. 35.50"/>
                        <TextBox x:Name="txtCantidad" Header="Cantidad" PlaceholderText="Ej. 10"/>

                        <ComboBox x:Name="cmbCategoria" Header="Categoría" PlaceholderText="Selecciona una categoría"
                                  HorizontalAlignment="Stretch">
                            <x:String>Papelería</x:String>
                            <x:String>Electrónica</x:String>
                            <x:String>Limpieza</x:String>
                            <x:String>Alimentos</x:String>
                        </ComboBox>

                        <CheckBox x:Name="chkDisponible" Content="Disponible para venta" IsChecked="True"/>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="btnAgregar" Content="Agregar producto" Click="btnAgregar_Click"
                                    Style="{StaticResource AccentButtonStyle}"/>
                            <Button x:Name="btnLimpiar" Content="Limpiar" Click="btnLimpiar_Click"/>
                        </StackPanel>

                        <TextBlock x:Name="lblMensaje" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- DERECHA: lista y total -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="24"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Productos registrados" FontSize="20"
                               FontWeight="SemiBold" Foreground="#0F766E"/>

                    <ListView Grid.Row="1" x:Name="lstProductos" BorderThickness="1" BorderBrush="#E2E8F0"
                              CornerRadius="8">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:Producto">
                                <Grid Padding="4,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{x:Bind Nombre}" FontWeight="SemiBold" FontSize="16"/>
                                        <TextBlock Text="{x:Bind Detalle}" Foreground="#64748B"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right">
                                        <Border Background="{x:Bind FondoEstado}" CornerRadius="12"
                                                Padding="10,3" HorizontalAlignment="Right">
                                            <TextBlock Text="{x:Bind EstadoTexto}" Foreground="{x:Bind ColorEstado}"
                                                       FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="{x:Bind SubtotalTexto}" Foreground="#64748B"
                                                   FontSize="12" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Acciones sobre el producto seleccionado -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
                        <Button x:Name="btnDisponibilidad" Content="Cambiar disponibilidad"
                                Click="btnDisponibilidad_Click"
                                Background="#FEF3C7" Foreground="#92400E"/>
                        <Button x:Name="btnEliminar" Content="Eliminar seleccionado"
                                Click="btnEliminar_Click"
                                Background="#FEE2E2" Foreground="#991B1B"/>
                    </StackPanel>

                    <!-- Resumen -->
                    <Border Grid.Row="3" Background="#F0FDFA" CornerRadius="8" Padding="14,10">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="lblResumen" Foreground="#64748B"/>
                            <TextBlock x:Name="lblTotal" Text="Valor total del inventario: $0.00"
                                       FontSize="18" FontWeight="SemiBold" Foreground="#0F766E"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>